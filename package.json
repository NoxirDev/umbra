{
  "name": "umbra",
  "version": "2.1.1",
  "description": "UMBRA — Stream Overlay by Noxir (v2.1.1 with Twitch Integration, Statistics & Notifications)",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:nsis": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "build:all": "electron-builder --win nsis portable"
  },
  "author": "Noxir",
  "license": "MIT",
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.noxir.umbra",
    "productName": "UMBRA",
    "copyright": "Copyright © 2026 Noxir (KayROSir)",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "publisherName": "Noxir",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "UMBRA",
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "license": "LICENSE",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "installerLanguages": [
        "en_US",
        "ru_RU"
      ],
      "language": "1049",
      "menuCategory": true,
      "multiLanguageInstaller": true,
      "displayLanguageSelector": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}",
      "requestExecutionLevel": "user"
    },
    "extraMetadata": {
      "main": "src/main/index.js"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "protocols": {
      "name": "umbra",
      "schemes": ["umbra"]
    },
    "fileAssociations": [
      {
        "ext": "umbra",
        "name": "UMBRA Project",
        "description": "UMBRA Overlay Project File",
        "role": "Editor"
      }
    ]
  }
}
