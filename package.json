{
  "name": "umbra",
  "version": "2.1.1",
  "description": "UMBRA — Stream Overlay by Noxir (v2.1.1 with Twitch Integration, Statistics & Notifications)",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --inspect",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:nsis": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable",
    "build:inno": "electron-builder --win inno",
    "build:appx": "electron-builder --win appx",
    "build:all": "electron-builder --win nsis portable inno appx",
    "icons:generate": "node scripts/generate-icons.js",
    "postinstall": "electron-builder install-app-deps",
    "test": "jest"
  },
  "author": "Noxir",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.3.9",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "jest": "^30.3.0",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "com.noxir.umbra",
    "productName": "UMBRA",
    "copyright": "Copyright © 2026 Noxir (KayROSir)",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "inno",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "installerSidebar": "assets/sidebar.bmp",
      "installerHeader": "assets/header.bmp",
      "uninstallerSidebar": "assets/sidebar.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "UMBRA",
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "license": "LICENSE",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "installerLanguages": [
        "en_US",
        "ru_RU"
      ],
      "language": "1049",
      "menuCategory": true,
      "multiLanguageInstaller": true,
      "displayLanguageSelector": true,
      "warningsAsErrors": false,
      "differentialPackage": true,
      "include": "build/installer.nsh"
    },
    "portable": {
      "artifactName": "${productName}-${version}-Portable.${ext}",
      "requestExecutionLevel": "user"
    },
    "appx": {
      "identityName": "Noxir.UMBRA",
      "publisher": "CN=Noxir",
      "publisherDisplayName": "Noxir",
      "displayName": "UMBRA Stream Overlay",
      "backgroundColor": "#1a1a2e",
      "artifactName": "${productName}-${version}-${arch}.msix",
      "languages": [
        "en-US",
        "ru-RU"
      ]
    },
    "extraMetadata": {
      "main": "src/main/index.js"
    },
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "protocols": {
      "name": "umbra",
      "schemes": [
        "umbra"
      ]
    },
    "fileAssociations": [
      {
        "ext": "umbra",
        "name": "UMBRA Project",
        "description": "UMBRA Overlay Project File",
        "role": "Editor"
      }
    ]
  }
}
